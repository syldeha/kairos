# Copy this file to ".env" (in this folder) and fill in your keys. Never commit .env.

# Required: the writing model (thinkers, answers, notes, checker) and embeddings
OPENAI_API_KEY=
# KAIROS_THINK_MODEL=gpt-5.6-luna
# EMBEDDING_MODEL=text-embedding-3-small

# Jev judge (TypeSafe): dispatcher, rater, "said / fit" judgments. Without it, an LLM judge is used.
TYPESAFE_API_KEY=
# Or through Vercel AI Gateway:
# AI_GATEWAY_API_KEY=

# Voice: Gradium speech-to-text and text-to-speech (Direct mode with voice)
GRADIUM_API_KEY=

# Workers: web search (Exa) and flights (Jinko). Optional.
EXA_API_KEY=
JINKO_API_KEY=
